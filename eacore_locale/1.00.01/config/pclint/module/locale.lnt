// Local structure member not referenced
-esym(754, EA::Core::LocaleHeader::languageid)
-esym(754, EA::Core::LocaleIndex::chunkid, EA::Core::LocaleIndex::chunksize, EA::Core::LocaleIndex::pad)
-esym(754, EA::Core::LocaleLanguage::chunkid, EA::Core::LocaleLanguage::languageid, EA::Core::LocaleLanguage::chunksize)
