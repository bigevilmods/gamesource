<project>

	<property name="cc.options">

		${property.value}

		-W4			<!-- Warning level 4 -->
		-Wall		<!-- Enable warnings normally disabled by default -->

		-wd4514		<!-- disable warning: "removed unreferenced inline function" -->
		-wd4668		<!-- disable warning: "'XXX' is not defined as a preprocessor macro, replacing with '0' for '#if/#elif'" -->
		-wd4710		<!-- disable warning: "function not inlined" -->
		-wd4711		<!-- disable warning: "selected for automatic inline expansion" -->
		-wd4820		<!-- disable warning: "added padding to struct" -->

	</property>

</project>
