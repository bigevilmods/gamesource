<project default="build">

    <optionset name="config.targetoverrides">
        <option name="test-build" value="include" />
        <option name="test-buildall" value="include" />
        <option name="test-run" value="include" />
        <option name="test-runall" value="include" />
    </optionset>
    <package name="rwcontroller" targetversion="1.04.00"/>

    <property name="runtime.rwcontroller.buildtype" value="Library"/>

    <!-- Capilano December XDK requires us to add WinRT support -->
    <do if="${config-system} == 'capilano'">
      <dependent name="CapilanoSDK"/>
      <property name="runtime.rwcontroller.buildtype" value="WinRTCppLibrary"/>
    </do>

    <property name="runtime.buildmodules" value="rwcontroller"/>

	<property name="platform-folder" value="${config-system}" />
	<do if="${config-system} == 'pc64'">
		<property name="platform-folder" value="pc" />
	</do>

    <fileset name="runtime.rwcontroller.sourcefiles">
        <includes name="source/*.cpp"/>
        <includes name="source/${platform-folder}/*.cpp"/>
    </fileset>

    <fileset name="runtime.rwcontroller.headerfiles">
        <includes name="include/**/*.h"/>
        <includes name="source/*.h"/>
        <includes name="source/${platform-folder}/*.h"/>
    </fileset>

    <fileset name="runtime.rwcontroller.bulkbuild.sourcefiles"
             fromfileset="runtime.rwcontroller.sourcefiles"/>

    <property name="runtime.rwcontroller.includedirs">
        ${package.dir}/include
    </property>

    <property name="runtime.rwcontroller.usedependencies">
      ControllerTuple
      coreallocator
      EAAssert
      EABase
      EAControllerUserPairing
      EAMessage
      EAStdC
      EASTL
      EAThread
      PPMalloc
      IEAController
      IEAUser
      InputSystem
      rwmath
      systems
    </property>

    <property name="runtime.rwcontroller.usedependencies" if="${config-system} == 'pc' || ${config-system} == 'pc64'">
        ${runtime.rwcontroller.usedependencies}
        DirectX
    </property>

    <include file="scripts/initialize.xml"/>
    <include file="source/doc-lib/doc-basic.build"/>

    <property name="test.buildmodules" value="test-rwcontroller"/>

    <property name="test.test-rwcontroller.buildtype" value="Program"/>

    <fileset name="test.test-rwcontroller.sourcefiles">
        <includes name="tests/*.cpp"/>
    </fileset>

    <property name="test.test-rwcontroller.usedependencies">
        ${runtime.rwcontroller.usedependencies}
        EABase
    </property>

    <property name="test.test-rwcontroller.builddependencies">
        unit
        EAAssert
        EAThread
        EAStdC
    </property>

    <property name="test.test-rwcontroller.runtime.moduledependencies">
        rwcontroller
    </property>

    <property name="test.test-rwcontroller.includedirs">
        ${runtime.rwcontroller.includedirs}
    </property>

    <fileset name="test.test-rwcontroller.libs" fromfileset="package.rwcontroller.libs"/>

    <target name="rwcontroller-test-run-trap2">
        <dependent name="trap2"/>
        <call target="test-run-trap2"/>
    </target>

</project>
