IDD_ABOUTBOX DIALOGEX 0, 0, 323, 125
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About WinBig"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,13,15,20,20
    LTEXT           "WinBig Version",IDC_STATIC,40,10,52,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2000-2005",IDC_STATIC,39,31,119,8
    DEFPUSHBUTTON   "OK",IDOK,185,16,56,14,WS_GROUP
    LTEXT           "EA Core, Ignition",IDC_STATIC,39,20,54,8
    EDITTEXT        IDC_HISTORY,7,43,309,73,ES_MULTILINE | ES_AUTOVSCROLL | 
                    ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL
    LTEXT           "XXXX",IDC_VERSION,90,10,18,8
END

IDD_PACKED_BIGFILE DIALOG  0, 0, 186, 86
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,34,37,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,94,37,50,14
    LTEXT           "This BIG file has been packed.  WinBig will need to extract it to a temporarry file",
                    IDC_STATIC,29,13,129,23
    CONTROL         "Never show this dialog again",IDC_NEVER_AGAIN,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,41,57,107,10
END

IDD_ON_ACTION DIALOG  0, 0, 185, 95
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Warning"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,64,74,50,14
    LTEXT           "You have just queued an action.",IDC_STATIC,19,13,104,8
    LTEXT           "This action will not occur until you save the file.  If you have just added a file, the file cannot be deleted until after the save.",
                    IDC_STATIC,20,26,150,25
    CONTROL         "Don't annoy me with this message again.",
                    IDC_ON_ACTION_NEVER_AGAIN,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,20,57,144,10
END

IDD_DIALOG_WISHLIST DIALOGEX 0, 0, 339, 217
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Wishlist"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,275,194,50,14
    EDITTEXT        IDC_WISHLIST_TEXT,7,7,325,182,ES_MULTILINE | ES_READONLY
    PUSHBUTTON      "E-mail Ignition",IDC_SENDTOMMAIL,188,194,83,15
END

IDD_PROPERTIES DIALOG  0, 0, 146, 76
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Big File Properties"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_FILE_ALIGNMENT,68,14,24,14,ES_AUTOHSCROLL | 
                    ES_NUMBER
    CONTROL         "Compress file on Save",IDC_PACK_FILE,"Button",
                    BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,15,35,86,10
    PUSHBUTTON      "Cancel",IDCANCEL,22,49,50,14
    DEFPUSHBUTTON   "OK",IDOK,78,49,50,14
    LTEXT           "File Alignment:",IDC_STATIC,16,17,50,9
END

IDD_NEW_VER DIALOG  0, 0, 223, 138
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "Take me there...",IDOK,109,34,63,14
    PUSHBUTTON      "Cancel",IDCANCEL,55,34,50,14
    LTEXT           "There is a new version of WinBig available.",IDC_STATIC,
                    36,18,137,8
    ICON            IDR_MAINFRAME,IDC_STATIC,30,32,21,20
    CONTROL         "Never show this dialog again.",IDC_NEVER_AGAIN,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,53,62,109,10
    LTEXT           "Clicking on ""Take me there..."" will attempt to open your explorer to r:\\funatic\\niwinski\\winbig copy the .exe to the location of your old WinBig (probably c:\\Program Files\\WinBig)",
                    IDC_STATIC,27,81,158,32
END

IDD_OPEN_BIGFILE DIALOGEX 0, 0, 186, 63
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "What do ya wanna do?"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,129,42,50,14
    PUSHBUTTON      "Add",IDC_OPEN_BIG_ADD,7,42,50,14
    DEFPUSHBUTTON   "Open",IDC_OPEN_BIG_OPEN,67,42,50,14
    LTEXT           "Static",IDC_OPEN_BIG_TEXT,19,15,142,21
END

IDD_SPAWN_EXTERNAL_APP DIALOGEX 0, 0, 211, 86
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "WinBig"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "&Yes",IDOK,43,58,50,14
    PUSHBUTTON      "&No",IDCANCEL,129,57,50,14
    LTEXT           "No viewer is associated with this file:",IDC_STATIC,53,
                    15,135,18,SS_NOPREFIX
    CONTROL         139,IDC_STATIC,"Static",SS_BITMAP,17,17,22,21
    LTEXT           "Would you like to launch NotePad ?",IDC_STATIC,54,38,
                    117,8
    CTEXT           "",IDC_FILE_WITH_NO_VIEWER,58,25,91,8
END


