    psLinearLight = 16,
    psLuminosity = 23,
    psMultiply = 5,
    psNormalBlend = 2,
    psOverlay = 12,
    psPassThrough = 1,
    psPinLight = 17,
    psSaturationBlend = 21,
    psScreen = 9,
    psSoftLight = 13,
    psVividLight = 15
};

