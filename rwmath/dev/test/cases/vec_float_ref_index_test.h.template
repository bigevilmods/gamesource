class VecFloatRefIndexCompareE : public GenericCompareE
{
public:
    bool Compare(float a, float b)
    {
        MakeVecRefIndex( aRef, 0, a );
        MakeVecRefIndex( bRef, 3, b );
        return aRef == bRef;
    }
};

