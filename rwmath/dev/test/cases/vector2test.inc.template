#ifdef GENERIC_TESTING
template<class FloatType>
UnitTestVector2<FloatType>::UnitTestVector2()
#else
UnitTestVector2::UnitTestVector2()
#endif
{

    //------------------------------------------------------------------------
    // create test data
    //========================================================================

    // Note:
    // 1) create a small array so cache miss is minimal, but an array,
    // as close to real environment as possible.
    // 2) currently doesn't test from heap, only create data on stack.

    int i;

    // generate some random numbers, so we can use for timing test
    for (i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        x_array[i] = static_cast<float_basic_type>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        y_array[i] = static_cast<float_basic_type>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
    }

    // array of v2 for testing
    for (i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        v2a_array[i].X() =static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v2a_array[i].Y() =static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v2a_norm_array[i] = Normalize(v2a_array[i]);

        v2b_array[i].X() =static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v2b_array[i].Y() =static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v2b_norm_array[i] = Normalize(v2b_array[i]);

        v2out_array[i].X() =static_cast<float_basic_type>(0.0);
        v2out_array[i].Y() =static_cast<float_basic_type>(0.0);
    }


}

#ifdef GENERIC_TESTING
template<class FloatType>
UnitTestVector2<FloatType>::~UnitTestVector2()
#else
UnitTestVector2::~UnitTestVector2()
#endif
{

}

