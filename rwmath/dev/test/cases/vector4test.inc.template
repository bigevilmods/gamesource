#ifdef HOST_TESTING
    rw::math::vpu::VectorIntrinsic UnitTestVector4::CreateVectorIntrinsic(float x, float y, float z, float w)
    {
        union
        {   
            rw::math::vpu::VectorIntrinsic v;
            float scalarFloat[4];
        } vecUnion;

        vecUnion.scalarFloat[0] = x;
        vecUnion.scalarFloat[1] = y;
        vecUnion.scalarFloat[2] = z;
        vecUnion.scalarFloat[3] = w;
        return vecUnion.v;
    }
#endif

#ifdef GENERIC_TESTING
template<class FloatType>
UnitTestVector4<FloatType>::UnitTestVector4()
#else
UnitTestVector4::UnitTestVector4()
#endif
{
    // Note:
    // 1) create a small array so cache miss is minimal, but an array,
    // as close to real environment as possible.
    // 2) currently doesn't test from heap, only create data on stack.

    //------------------------------------------------------------------------
    // create test data
    //========================================================================

    int i;

    // generate some random numbers, so we can use for timing test
    for (i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        x_array[i] = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        y_array[i] = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        z_array[i] = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        w_array[i] = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
    }

    for (i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        v4a_array[i].X() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v4a_array[i].Y() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v4a_array[i].Z() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v4a_array[i].W() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v4a_norm_array[i] = Normalize(v4a_array[i]);

        v4b_array[i].X() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v4b_array[i].Y() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v4b_array[i].Z() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v4b_array[i].W() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v4b_norm_array[i] = Normalize(v4b_array[i]);

        v4out_array[i].X() =0.0f;
        v4out_array[i].Y() =0.0f;
        v4out_array[i].Z() =0.0f;
        v4out_array[i].W() =0.0f;
    }

    for (i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
#ifdef HOST_TESTING
        vecintrinsic_array[i] = CreateVectorIntrinsic(
            (float)rw::math::Random() / (float)(rw::math::Random() % 30),
            (float)rw::math::Random() / (float)(rw::math::Random() % 30),
            (float)rw::math::Random() / (float)(rw::math::Random() % 30),
            (float)rw::math::Random() / (float)(rw::math::Random() % 30)
            );
#endif
    }


}

