      <TEST NAME="matrix44affine_getzero">
      <![CDATA[

        SetFunctionName("GetMatrix44Affine_Zero()");
        Matrix44Affine m = GetMatrix44Affine_Zero();
        bool isSame = true;
        for(int col=0;col<3;++col)
        {
            for(int row=0;row<4;++row)
            {
                isSame &= m.GetElem(row, col) == (float_test_type)0.0f;
            }
        }
        Validate( isSame );

      ]]>
      </TEST>     

      <TEST NAME="matrix44affinepacked_getzero">
      <![CDATA[

        SetFunctionName("GetMatrix44AffinePacked_Zero()");
        Matrix44AffinePacked m = GetMatrix44AffinePacked_Zero();
        bool isSame = true;
        for(int col=0;col<3;++col)
        {
            for(int row=0;row<4;++row)
            {
                isSame &= m.GetElem(row, col) == (float_test_type)0.0f;
            }
        }
        Validate( isSame );

      ]]>
      </TEST>     

      <TEST NAME="matrix44affinepacked_getidentity">
      <![CDATA[

        SetFunctionName("GetMatrix44AffinePacked_Identity()");
        Matrix44AffinePacked m = GetMatrix44AffinePacked_Identity();
        bool isSame = true;
        for(int col=0;col<3;++col)
        {
            for(int row=0;row<4;++row)
            {
                float_test_type expectedValue = (row == col) ? ((float_test_type)1.0f) : ((float_test_type)0.0f);
                isSame &= m.GetElem(row, col) == expectedValue;
            }
        }
        Validate( isSame );

      ]]>
      </TEST>     

