      <TEST NAME="pi_consistency">
      <![CDATA[

      // This test compares the bit representation of PI on both the PPU and SPU to ensure they
      // are identical.
      #if defined EA_PLATFORM_PS3 || defined EA_PLATFORM_PS3_SPU
        SetFunctionName("PI");

        union FloatIntUnion
        {
            float fValue;
            unsigned int iValue;
        } floatIntUnion;

        floatIntUnion.fValue = PI;
        Validate(floatIntUnion.iValue == 0x40490FDB);

      #endif

      ]]>
      </TEST>

      <TEST NAME="max_float_value">
      <![CDATA[

      // This test compares the bit representation of MAX_FLOAT to an expected hex value.
      // MAX_FLOAT should be equal to this value assuming the platform uses IEEE single precision floating
      // point representation.

      SetFunctionName("MAX_FLOAT");

      union FloatIntUnion
      {
          float fValue;
          unsigned int iValue;
      } floatIntUnion;

      floatIntUnion.fValue = MAX_FLOAT;
      Validate(floatIntUnion.iValue == 0x7f7fffffu);

      ]]>
      </TEST>
