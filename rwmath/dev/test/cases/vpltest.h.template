    bool IsEqualFloat( ::rw::math::vpu::VectorIntrinsicInParam v0, ::rw::math::vpu::VectorIntrinsicInParam v1 )
    {
        ::rw::math::vpu::detail::VectorIntrinsicUnion v0u, v1u;
        v0u.vector = v0;
        v1u.vector = v1;
        return( 
                v0u.scalarFloat[0] == v1u.scalarFloat[0] &&
                v0u.scalarFloat[1] == v1u.scalarFloat[1] &&
                v0u.scalarFloat[2] == v1u.scalarFloat[2] &&
                v0u.scalarFloat[3] == v1u.scalarFloat[3]
              );
    }

    bool IsEqualFloatWithinPercent( rw::math::vpu::VectorIntrinsicInParam v0, rw::math::vpu::VectorIntrinsicInParam v1, float percent )
    {
        rw::math::vpu::detail::VectorIntrinsicUnion v0u, v1u;
        v0u.vector = v0;
        v1u.vector = v1;
        return( 
                IsEqualWithinPercent(v0u.scalarFloat[0], v1u.scalarFloat[0], percent) &&
                IsEqualWithinPercent(v0u.scalarFloat[1], v1u.scalarFloat[1], percent) &&
                IsEqualWithinPercent(v0u.scalarFloat[2], v1u.scalarFloat[2], percent) &&
                IsEqualWithinPercent(v0u.scalarFloat[3], v1u.scalarFloat[3], percent)
              );
    }

	bool IsEqualBitwise( ::rw::math::vpu::VectorIntrinsicInParam v0, ::rw::math::vpu::VectorIntrinsicInParam v1 )
    {
        ::rw::math::vpu::detail::VectorIntrinsicUnion v0u, v1u;
        v0u.vector = v0;
        v1u.vector = v1;
        return( 
                v0u.scalarUInt[0] == v1u.scalarUInt[0] &&
                v0u.scalarUInt[1] == v1u.scalarUInt[1] &&
                v0u.scalarUInt[2] == v1u.scalarUInt[2] &&
                v0u.scalarUInt[3] == v1u.scalarUInt[3]
              );
    }

    bool IsSimilarFloat( float v0, float v1, float tolerance )
    {
        float difference = v0 - v1;
        if( difference < 0.0f )
        {
            difference *= -1.0f;
        }
        return( difference < tolerance );
    }

    bool IsSimilarDouble( double v0, double v1, double tolerance )
    {
        double difference = v0 - v1;
        if( difference < 0.0 )
        {
            difference *= -1.0;
        }
        return( difference < tolerance );
    }

	bool IsSimilarFloat( rw::math::vpu::VectorIntrinsicInParam v0, rw::math::vpu::VectorIntrinsicInParam v1, float tolerance )
    {
        ::rw::math::vpu::detail::VectorIntrinsicUnion v0u, v1u;
        v0u.vector = v0;
        v1u.vector = v1;
        return( 
                IsSimilarFloat( v0u.scalarFloat[0], v1u.scalarFloat[0], tolerance ) &&
                IsSimilarFloat( v0u.scalarFloat[1], v1u.scalarFloat[1], tolerance ) &&
                IsSimilarFloat( v0u.scalarFloat[2], v1u.scalarFloat[2], tolerance ) &&
                IsSimilarFloat( v0u.scalarFloat[3], v1u.scalarFloat[3], tolerance )
              );
    }

