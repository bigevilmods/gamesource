#ifdef HOST_TESTING
    rw::math::vpu::VectorIntrinsic UnitTestVecFloatRefIndex::CreateVectorIntrinsic(float x, float y, float z, float w)
    {
        union
        {   
            rw::math::vpu::VectorIntrinsic v;
            float scalarFloat[4];
        } vecUnion;

        vecUnion.scalarFloat[0] = x;
        vecUnion.scalarFloat[1] = y;
        vecUnion.scalarFloat[2] = z;
        vecUnion.scalarFloat[3] = w;
        return vecUnion.v;
    }
#endif

