#ifdef GENERIC_TESTING
template<class FloatType>
UnitTestMiscHost<FloatType>::UnitTestMiscHost()
#else
UnitTestMiscHost::UnitTestMiscHost()
#endif
{

    // Note:
    // 1) create a small array so cache miss is minimal, but an array,
    // as close to real environment as possible.
    // 2) currently doesn't test from heap, only create data on stack.


    //------------------------------------------------------------------------
    // create test data
    //========================================================================
    int i;
    // generate some random numbers, so we can use for timing test
    for (i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        v3a_array[i].X() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        v3a_array[i].Y() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        v3a_array[i].Z() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);

        v3b_array[i].X() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        v3b_array[i].Y() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        v3b_array[i].Z() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);

        v3c_array[i].X() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        v3c_array[i].Y() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        v3c_array[i].Z() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);

        v3d_array[i].X() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        v3d_array[i].Y() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        v3d_array[i].Z() = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
    }

}

