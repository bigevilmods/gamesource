#ifdef GENERIC_TESTING
template<class FloatType>
UnitTestVector3<FloatType>::UnitTestVector3()
#else
UnitTestVector3::UnitTestVector3()
#endif
{

    // Note:
    // 1) create a small array so cache miss is minimal, but an array,
    // as close to real environment as possible.
    // 2) currently doesn't test from heap, only create data on stack.


    //------------------------------------------------------------------------
    // create test data
    //========================================================================
    for (int i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        x_array[i] = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        y_array[i] = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        z_array[i] = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
    }

    // array of v3 for testing
    for (int i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        v3a_array[i].X() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v3a_array[i].Y() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v3a_array[i].Z() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v3a_norm_array[i] = Normalize(v3a_array[i]);

        v3b_array[i].X() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v3b_array[i].Y() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v3b_array[i].Z() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
        v3b_norm_array[i] = Normalize(v3b_array[i]);

        v3out_array[i].X() = 0.0f;
        v3out_array[i].Y() = 0.0f;
        v3out_array[i].Z() = 0.0f;
    }

}

#ifdef GENERIC_TESTING
template<class FloatType>
UnitTestVector3<FloatType>::~UnitTestVector3()
#else
UnitTestVector3::~UnitTestVector3()
#endif
{

}

