#ifdef GENERIC_TESTING
template<class FloatType>
UnitTestQuaternion<FloatType>::UnitTestQuaternion()
#else
UnitTestQuaternion::UnitTestQuaternion()
#endif
{

    // Note:
    // 1) create a small array so cache miss is minimal, but an array,
    // as close to real environment as possible.
    // 2) currently doesn't test from heap, only create data on stack.


    //------------------------------------------------------------------------
    // create test data
    //========================================================================

    int i;
    // generate some random numbers, so we can use for timing test
    for (i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        x_array[i] = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        y_array[i] = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        z_array[i] = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
        w_array[i] = (float)rw::math::Random() / (float)(rw::math::Random() % 30 + 1);
    }

    for (i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        xArray[i] = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1);
    }

    for (i = 0; i < testing::RW_MATH_UNITTEST_TEST_VECTOR_ARRAY_SIZE; i++)
    {
        qAArray[i].X() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        qAArray[i].Y() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        qAArray[i].Z() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        qAArray[i].W() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        qANormArray[i]= Normalize(qAArray[i]);

        qBArray[i].X() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        qBArray[i].Y() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        qBArray[i].Z() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        qBArray[i].W() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        qBNormArray[i]= Normalize(qBArray[i]);

        qOutArray[i].X() = 0.0f ;
        qOutArray[i].Y() = 0.0f ;
        qOutArray[i].Z() = 0.0f ;
        qOutArray[i].W() = 0.0f ;

        qCompressedArray[i]= 0;

        v3a_array[i].X() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v3a_array[i].Y() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v3a_array[i].Z() = static_cast<float>(rw::math::Random()) / static_cast<float>(rw::math::Random() % 30 + 1) ;
        v3NormArray[i]= Normalize(v3a_array[i]);

        v3OutArray[i].X() = 0.0f ;
        v3OutArray[i].Y() = 0.0f ;
        v3OutArray[i].Z() = 0.0f ;

        m33Array[i] = Matrix33FromQuaternion( qANormArray[i] );
        m44Array[i] = Matrix44FromQuaternion( qANormArray[i] );

    }

}

