<!ELEMENT INPUTSPEC       (GLOBALDIR?, (DIR|FILE|GROUP)*)>

<!ELEMENT GLOBALDIR       (FILEPATTERN|EXCLUDE|EXCLUDEPATTERN|EXCLUDE_SYMLINKS)*>
<!ATTLIST GLOBALDIR       RECURSIVE (YES|NO|yes|no) "NO"	EXCLUDESYMLINKS (YES|NO|yes|no) "NO">

<!ELEMENT DIR             (FILEPATTERN|EXCLUDE|EXCLUDEPATTERN|EXCLUDE_SYMLINKS)*>
<!ATTLIST DIR             SOURCE CDATA #REQUIRED    RECURSIVE (YES|NO|yes|no) "NO"	EXCLUDESYMLINKS (YES|NO|yes|no) "NO">

<!ELEMENT FILE            EMPTY>
<!ATTLIST FILE            SOURCE CDATA #REQUIRED>

<!ELEMENT GROUP           (DIR|FILE|GROUP)*>
<!ATTLIST GROUP           NAME CDATA #REQUIRED    TITLE CDATA #IMPLIED>

<!ELEMENT FILEPATTERN     (#PCDATA)>
<!ELEMENT EXCLUDE         (#PCDATA)>
<!ELEMENT EXCLUDEPATTERN  (#PCDATA)>
