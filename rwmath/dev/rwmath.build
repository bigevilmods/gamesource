<?xml version="1.0" encoding="utf-8"?>
<project default="build">

    <optionset name="config.targetoverrides">
        <option name="package" value="exclude" />
        <option name="test-build" value="exclude" />
        <option name="test-buildall" value="include" />
        <option name="test-run" value="include" />
        <option name="test-runall" value="include" />
        <option name="vcproj" value="include" />
        <option name="vcprojall" value="include" />
        <option name="vcprojtest" value="include" />
        <option name="vcprojalltest" value="include" />      
        <option name="lint" value="include" />      
    </optionset>

  <do if="@{PropertyExists('nant.framework3')}">
    <optionset name="config.targetoverrides">
      <option name="test-build" value="include" />
    </optionset>

  </do>
    <!--
       - 'math-defines' are tokenized and stored in 'math-defines-list'.  These definitions are then 
       - passed to the compiler when building the math library and the math unit tests.
      -->
    <property name="math-defines" value="" unless="@{PropertyExists('math-defines')}" />
    <property name="math-defines-list" value="" />
    <foreach property="single-definition" item="String" in="${math-defines}" delim=" ">
        <property name="math-defines-list">
            ${math-defines-list}
            ${single-definition}
        </property>
    </foreach>

    <property name="skip-spu-build" value="false" unless="@{PropertyExists('skip-spu-build')}" />

    <!-- Get the version number from current directory -->
    <property name="currDir" value="@{PathGetFullPath('.')}" />
    <property name="currVer" value="@{PathGetFileName('${currDir}')}" />
    <package name="rwmath" targetversion="${currVer}" />
        
    <property name="docs-dir" value="${package.builddir}/doc" />
    <property name="preprocessed-docs-dir" value="${package.builddir}/preprocessed_docs" />
    <property name="doc.type" value="HelpToolKit" />
    <property name="doxygen.sourcebooksdir" value="${package.dir}/src/doc/toolkit" />
    <property name="doxygen.inputspecfile" value="${package.builddir}/doc/inputspec.xml" />
    <property name="doxygen.configfile" value="${package.dir}/src/doc/toolkit/config.doxy" />
    
    <property name="runtime.buildmodules" value="rwmath" />
    <property name="runtime.buildmodules" value="${runtime.buildmodules} rwmath_spu" if="(${config-system}==ps3) and (${skip-spu-build}!=true)" />

    <!--
       -  Configure the main runtime
      -->
    <property name="runtime.rwmath.buildtype" value="Library" />
    <property name="runtime.rwmath.defines" value="${math-defines-list}" />
    <property name="runtime.rwmath.usedependencies" value="EABase" />

    <fileset name="runtime.rwmath.sourcefiles"> 
        <includes name="src/*.cpp" />
        <includes name="src/wii/**.cpp" if="${config-system}==rev" />
        <includes name="src/neon/vpu/*.cpp" if="${config-system}==iphone or ${config-system}==palm or ${config-system}==android or ${config-system}==psp2" />
        <includes name="src/psp2/**.cpp" if="${config-system}==psp2"/>
        <includes name="src/xenon/**.cpp" if="${config-system}==xenon"/>
    </fileset>
    <fileset name="runtime.rwmath.asmsourcefiles" if="${config-system}==ps3">
        <includes name="src/ps3/ppu/*.s" />
    </fileset>
    <fileset name="runtime.rwmath.bulkbuild.sourcefiles" fromfileset="runtime.rwmath.sourcefiles" />
    
    <property name="runtime.rwmath.includedirs">
        ${package.dir}/include
    </property>
    
    <!--
       -  Configure the SPU runtime
      -->
    <property name="runtime.rwmath_spu.buildtype" value="SPULibrary" />
    <property name="runtime.rwmath_spu.defines" value="${math-defines-list}" />
    <property name="runtime.rwmath_spu.usedependencies" value="EABase" />
    
    <fileset name="runtime.rwmath_spu.sourcefiles"> 
        <includes name="src/*.cpp" />
        <includes name="src/ps3/spu/*.s" />
    </fileset>
    
    <property name="runtime.rwmath_spu.includedirs">
        ${package.dir}/include
    </property>

    <!--
       -  Configure the test program
      -->
    <property name="test.buildmodules" value="rwmathtest" />

    <!-- Create a custom build configuration -->
    <do if="'${config-system}'=='ps3'">

        <optionset name="custom-config-options-program-spu" fromoptionset="config-options-program-spu">
            <option name="buildset.name" value="CustomizedSPUProgram" />
            <option name="buildset.cc.options" value="-ffunction-sections -mraw" />
            <option name="buildset.link.options" value="-mraw" />
        </optionset>

        <task name="GenerateBuildOptionsetSPU" configsetname="custom-config-options-program-spu" />
    </do>

    <do if="@{PropertyExists('recursive-spu-build')}">
        <property name="test.buildmodules" value="" />
        <foreach item="Folder" in="${package.builddir}/test/ps3_spu/" property="test-folder" if="${config-system}==ps3">
            <!-- determine the name of the test -->
            <property name="test-name" value="@{PathGetFileName(${test-folder})}" />

            <!-- Add the test to the list of test modules to build -->
            <property name="test.buildmodules" value="${test.buildmodules} ${test-name}" />

            <!--
               -  Configure the SPU test programs
              -->
            <property name="test.${test-name}.buildtype" value="CustomizedSPUProgram" />
            <property name="test.${test-name}.defines" value="${math-defines-list}" />
            <property name="test.${test-name}.usedependencies" value="EABase" />
            <property name="test.${test-name}.builddependencies" value="EAAssert EAStdC EAThread" />
            <property name="test.${test-name}.runtime.moduledependencies" value="rwmath_spu" />

          <!--
               - For some odd reason the Sony runtime is unable to load the SPU elf
               - file's.  An out of memory error is reported.  Stripping the elf's
               - solves the problem.  But it seems like an unnecessary step since
               - the symbols do not need to be uploaded to the SPU.  If Sony fixes
               - the runtime issue, this stripping step will be unnecessary.
              -->
            <target name="test.${test-name}.postbuildtarget" hidden="true"> 
                <!-- I would like to do use the line below, but it doesn't work :-( It ends up running the command for the last test for each test.  It looks like it isn't instantiating the task properly. -->
                <!-- <exec program="${package.PlayStation3GCC.appdir}\host-win32\spu\bin\spu-lv2-strip.exe" commandline="${package.builddir}/${config}/bin/test/${test-name}.elf"/> -->

                <!-- Instead I do this absolutely evil hack to take the target name, and 'extract' the correct filename from it. -->
                <property name="filename" value="@{StrRemove('${target.name}', '0', '5')}" />
                <property name="filename" value="@{StrReplace('${filename}', 'postbuildtarget', 'elf')}" />
                <exec program="${package.ps3sdk.appdir}\host-win32\spu\bin\spu-lv2-strip.exe" commandline="${package.builddir}/${config}/bin/test/${filename}" />
            </target>

            <property name="test.${test-name}.includedirs">
                ${package.dir}/include
                ${package.dir}/test/harness
                ${test-folder}/test_0
                ${test-folder}
            </property>

            <fileset name="test.${test-name}.sourcefiles">
                <includes name="${test-folder}/*.cpp" />
                <includes name="test/harness/unittest.cpp" />
                <includes name="test/harness/unittest_output.cpp" />
                <includes name="test/harness/unittest_spuproxy.cpp" />
                <includes name="test/harness/testing_math.cpp" />
            </fileset>

        </foreach>
    </do>

    <optionset name="config-options-program-sse2" fromoptionset="config-options-program">
      <option name="buildset.name" value="SSE2Program" />
      <option name="buildset.cc.options">
        ${option.value} -arch:SSE2
      </option>
    </optionset>
    <task name="GenerateBuildOptionset" configsetname="config-options-program-sse2" />

    <property name="test.enableSSE2" value="false" unless="@{PropertyExists('test.enableSSE2')}" />

    <property name="test.rwmathtest.buildtype" value="Program" />
    <do if="${test.enableSSE2}">
      <echo message="                          WARNING: SSE2 is only available for PC configs!                      " unless="${config-system}==pc" />
      <property name="test.rwmathtest.buildtype" value="SSE2Program" if="${config-system}==pc" />
    </do>
    <property name="test.rwmathtest.usedependencies" value="EABase" />
    <property name="test.rwmathtest.builddependencies" value="EAStdC EAAssert EAThread EATest EASTL" />
    <property name="test.rwmathtest.runtime.moduledependencies" value="rwmath" />
    <property name="test.rwmathtest.defines">
        ${math-defines-list}
    </property>

    <depends property="test-needs-generating">
        <!-- Only wild cards are used for inputs so the dependency won't fail if the test folder is deleted (e.g. during code stripping) -->
        <inputs>
            <includes name="test/cases/**" />
            <includes name="test/*.py" />
        </inputs> 
        <outputs>
            <includes name="${package.builddir}/test/${config-system}/test-timestamp" />
        </outputs>
    </depends>

    <property name="spu-test-needs-generating" value="false" unless="${config-system}==ps3" />
    <depends property="spu-test-needs-generating" if="${config-system}==ps3">
        <!-- Only wild cards are used for inputs so the dependency won't fail if the test folder is deleted (e.g. during code stripping) -->
        <inputs>
            <includes name="test/cases/**" />
            <includes name="test/*.py" />
        </inputs> 
        <outputs>
            <includes name="${package.builddir}/test/ps3_spu/test-timestamp" />
        </outputs>
    </depends>

    <!-- Framework 3 specification for pre-build target (preprocess property can execute tasks and targets) -->
    <property name="test.rwmathtest.preprocess" value="test.rwmathtest.prebuildtarget"/>

    <property name="test.rwmathtest.vcproj.prebuildtarget" value="test.rwmathtest.vcproj.prebuildtarget" />

    <!-- Wrap the call to the NAnt pre-build target, so that the target is only executed once, even when
         this target is used from a 'call' task. -->
    <target name="test.rwmathtest.vcproj.prebuildtarget" depends="test.rwmathtest.prebuildtarget" />

    <target name="test.rwmathtest.prebuildtarget" hidden="true">
        <choose>
            <do if="@{PlatformIsWindows()}">
                <dependent name="ActivePython" />
                <property name="math-python-interpreter" value="${package.ActivePython.exe}" />
            </do>
            <do>
                <property name="math-python-interpreter" value="python" />
            </do>
        </choose>

        <!-- Additional properties for generating unit tests. -->
        <property name="additional-test-options" value="" unless="@{PropertyExists('additional-test-options')}" />

        <do if="${test-needs-generating}"> 
            <do if="${config-system}!=ps3">
                <echo message="buildtests.py --output-dir=${package.builddir}/test/${config-system} ${additional-test-options} --generate-separate-instance-cpps" />
                <exec program="${math-python-interpreter}" workingdir="${package.dir}/test" commandline="buildtests.py --output-dir=${package.builddir}/test/${config-system} ${additional-test-options} --generate-separate-instance-cpps" message="Generating Renderware Math Unit Tests for ${config-system} because of old or missing test-timestamp file." />
            </do>

            <do if="${config-system}==ps3">
                <exec program="${math-python-interpreter}" workingdir="${package.dir}/test" commandline="buildtests.py --output-dir=${package.builddir}/test/${config-system} --generate-ppu-batch-file ${additional-test-options}" message="Generating Renderware Math Unit Tests for ${config-system} because of old or missing test-timestamp file." />
            </do>
        </do>

        <do if="(${config-system}==ps3) and (${skip-spu-build}!=true)">
            <do if="${spu-test-needs-generating}">
                <exec program="${math-python-interpreter}" workingdir="${package.dir}/test" commandline="buildtests.py --output-dir=${package.builddir}/test/ps3_spu -m 80 --generate-spu-response-file ${additional-test-options}" message="Generating Renderware Math Unit Tests for ps3_spu" />
            </do>
            <!-- Copy a batchfile that has all the commands needed to run the unit tests on the SPU -->
            <copy file="${package.builddir}/test/ps3_spu/spu-response.cmd" tofile="${package.builddir}/${config}/bin/test/spu-response.cmd" />
        </do>
    </target>

    <property name="test.rwmathtest.vcproj.post-build-step" if="@{PropertyExists('Dll')}">
      ${nant.location}\nant.exe -D:config=${config} -D:package.configs=${config} -buildfile:${nant.project.buildfile} -buildroot:${nant.project.buildroot} -masterconfigfile:${nant.project.masterconfigfile} -D:skip-spu-build=${skip-spu-build} test.rwmathtest.postbuildtarget
    </property>

    <target name="test.rwmathtest.postbuildtarget" hidden="true">
        <do if="@{PropertyExists('Dll')}">
          <dependent name="EAAssert" />
          <dependent name="EAStdC" />
          <dependent name="EAThread" />
          <copy todir="${package.configbindir}/test" overwrite="true" clobber="true" flatten="true">
            <fileset>
              <includes name="${package.EAAssert.builddir}\${config}\bin\EAAssert.dll" />
              <includes name="${package.EAStdC.builddir}\${config}\bin\EAStdC.dll" />
              <includes name="${package.EAThread.builddir}\${config}\bin\EAThread.dll" />
            </fileset>
          </copy>
        </do>
      
        <do if="(${config-system}==ps3) and (${skip-spu-build}!=true)">
          <echo message="Building the SPU tests" /> 
          <nant buildfile="rwmath.build" target="test-build">
              <property name="config" value="${config}" />
              <property name="recursive-spu-build" value="true" />
          </nant>
        </do>
    </target>

  <property name="test.rwmathtest.includedirs">
        ${package.dir}/include
        ${package.builddir}/test/test_0
        ${package.dir}/test/harness
    </property>
    
    <fileset name="test.rwmathtest.libs" if="${config-system}==xenon">
        <includes name="${package.xenonsdk.appdir}/lib/xbox/tracerecording.lib" />
        <includes name="${package.xenonsdk.appdir}/lib/xbox/xbdm.lib" />
        <includes name="${package.xenonsdk.appdir}/lib/xbox/xonline.lib" />
    </fileset>

    <fileset name="test.rwmathtest.libs" if="${config-system}==ps3">
        <includes name="${package.ps3sdk.libsn}"/>
    </fileset>

    <fileset name="test.rwmathtest.libs" if="${config-system}==psp2">
        <includes name="${package.psp2sdk.libdir}\libSceSysmodule_stub.a"/>
        <includes name="${package.psp2sdk.libdir}\libSceNet_stub.a"/>
        <includes name="${package.psp2sdk.libdir}\libSceNetCtl_stub.a"/>
    </fileset>

    <fileset name="test.rwmathtest.sourcefiles">
        <includes name="${package.builddir}/test/${config-system}/test_0/*.cpp" />
        <includes name="test/harness/*.cpp" />
        <includes name="test/spulauncher/spulauncher.cpp" if="${config-system}==ps3" />
    </fileset>

    <fileset name="test.rwmathtest.sourcefiles" append="true" if="${config-system}==iphone and @{PropertyExists('package.iphonesdk.test.main')}">
        <includes name="${package.iphonesdk.test.main}" />
    </fileset>

    <dependent name="eaconfig" initialize="false" />
	<fileset name="test.rwmathtest.deploy-contents-fileset">
		<includes name="${package.configbindir}/test/**" />
	</fileset>

    <do unless="@{PropertyExists('nant.framework3')}">
      <!-- Copy of eaconfig's test-build target.  For all platforms except
           AirPlay this is identical to the test-build target in eaconfig.
           For the Airplay platform, eaconfig is not used properly so the
           test prebuild target is not called as it is on the other platforms.
           Therefore, in order to make this work on Airplay, the test-build
           target has been modified to have an explicit dependency on the
           test.rwmathtest.prebuildtarget target.  When the time comes that
           Airplay uses eaconfig as it should do, this target may be removed
           and we can use the one in eaconfig instead.
      -->
      <do unless="${config-system} == airplay">
          <target name="test-build" style="build" description="Build the tests for a specific configuration">
              <call target="build" force="false" if="@{TargetExists('build')}" />
              <property name="eaconfig.build.target" value="eaconfig-build" />
              <property name="eaconfig.build.group" value="test" />
              <call target="eaconfig-build-caller" force="true" />
          </target>
      </do>

      <do if="${config-system} == airplay">
          <target name="test-build" depends="test.rwmathtest.prebuildtarget" style="build" description="Build the tests for a specific configuration">
              <call target="build" force="false" if="@{TargetExists('build')}" />
              <property name="eaconfig.build.target" value="eaconfig-build" />
              <property name="eaconfig.build.group" value="test" />
              <call target="eaconfig-build-caller" force="true" />
          </target>
      </do>
    </do>
    <!--
       - The doc.prebuildtarget is used to programmatically generate documentation
       - that should be part of the doxygen build.
       - For example, the VPL library headers are parsed to generate documentation
       - that specifies what functionality is supported on each platform.  The API
       - documentation also has platform support information automatically added.
      -->
    <target name="doc.prebuildtarget" hidden="true"> 
        <dependent name="ActivePython" />
        <dependent name="ps3sdk" />
        <echo message="Doc Prebuild Step" />
        <!-- Delete previously generated docs if they exist. -->
        <delete dir="${preprocessed-docs-dir}" failonmissing="false" />
        <!-- Create directory for new docs-->
        <mkdir dir="${preprocessed-docs-dir}" />
        <property name="script.verbosity.property" value="--verbose" if="${nant.verbose}" />
        <property name="script.verbosity.property" value="" unless="${nant.verbose}" />
        <!-- Generate/preprocess documentation -->
        <dependent name="EABase" />
        <exec program="${package.ActivePython.exe}" workingdir="${package.dir}/src/scripts" commandline="vpl_api_parse.py ${script.verbosity.property} --output-dir=${preprocessed-docs-dir} --input-file=..\..\include\rw\math\vpl\float_operation.h --input-file=..\..\include\rw\math\vpl\mem_operation.h --input-file=..\..\include\rw\math\vpl\vec_operation.h --input-file=..\..\include\rw\math\vpl\vecutil_operation.h --include-dir=..\..\include --include-dir=${package.EABase.dir}/include/common --cpp=${package.ps3sdk.appdir}\host-win32\ppu\bin\ppu-lv2-cpp.exe" message="Generating Renderware Math Unit Tests for ${config-system} because of old or missing test-timestamp file." />

        <!-- Generate the inputspec.xml file used by Doxygen -->
        <mkdir dir="${docs-dir}" /> <!-- Make sure output dir exists -->
        <exec program="${package.ActivePython.exe}" workingdir="${package.dir}/src/scripts" commandline="generate_doc_inputspec.py ${package.dir} ${package.builddir} ${package.builddir}/doc/inputspec.xml" message="Generating Renderware Math Unit Tests for ${config-system} because of old or missing test-timestamp file." />
    </target>

    <target name="package">
        <!-- Ensure the documentation is built prior to packaging. -->
        <call target="doc"/>
        <zip zipfile='${package.builddir}/${package.name}-${package.targetversion}.zip' zipentrydir='${package.name}\${package.targetversion}'>
            <fileset basedir='${package.dir}'>
                <includes name="*.xml"/>
                <includes name="*.dox"/>
                <includes name="*.txt"/>
                <includes name="rwmath.*"/>
                <includes name="config\**"/>
                <includes name="doc\**"/>
                <includes name="include\**"/>
                <includes name="scripts\**"/>
                <includes name="src\**"/>
                <includes name="test\**"/>
            </fileset>
        </zip>
    </target>

    <property name="package.consoledeployment" value="true"/>

</project>
